# Optional integrations. All disabled by default; the app runs fully offline without keys.
GEMINI_ENABLED=false
GEMINI_API_KEY=
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
TIGER_ENABLED=false
TIGER_DATABASE_URL=

# Optional read-only market data for the simulator (Alpaca Market Data). Never used to place orders.
# Without keys the simulator uses yfinance, then built-in offline prices. Never commit real keys.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Leaders (devnet ONLY; the publisher refuses any other cluster). Throwaway keypair, never a real wallet.
SOLANA_RPC_URL=https://api.devnet.solana.com
LEADER_KEYPAIR_PATH=.keys/leader.json
